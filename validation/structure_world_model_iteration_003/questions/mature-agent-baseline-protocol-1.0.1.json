{
  "protocol_ref": "ITER-003-MATURE-SOURCE-AGENT-BASELINE@1.0.1",
  "purpose": "prevent the in-repository direct loop from becoming a deliberately weak comparator",
  "agent": {
    "implementation": "Codex CLI",
    "prepared_version": "codex-cli 0.147.0-alpha.1.2",
    "prepared_binary_sha256": "9f6748b4ab10ffc92c28b9ccedae89e61a302bbc011df7d276ee38f55906e481",
    "resolver": "RECORD_EXACT_BINARY_PATH_VERSION_DIGEST_AND_ACTUAL_MODEL_AT_G0_AND_RUN",
    "drift": "ANY_BINARY_MODEL_CONFIG_OR_PROMPT_DRIFT_REQUIRES_RERUN_AND_NEW_BOUND_RESULT"
  },
  "command_contract": {
    "argv_order": ["BINARY", "GLOBAL_FLAGS", "SUBCOMMAND", "EXEC_FLAGS", "PROMPT"],
    "global_flags": ["--ask-for-approval", "never"],
    "subcommand": "exec",
    "exec_flags": ["--ephemeral", "--ignore-user-config", "--ignore-rules", "--sandbox", "read-only", "--output-schema", "MATURE_AGENT_ANSWER_SCHEMA", "--json"],
    "web_search": "DISABLED",
    "network_tools": "DISABLED",
    "workspace": "ISOLATED_EXACT_SOURCE_CHECKOUT_ONLY",
    "additional_directories": [],
    "prompt_input": "QUESTION_LANGUAGE_EXACT_REVISION_SCOPE_AND_CITATION_REQUIREMENT_WITHOUT_EXPECTED_ORACLE_WORLD_MODEL_OR_DIRECT_RESULTS"
  },
  "answer_schema": {
    "path": "validation/structure_world_model_iteration_003/questions/mature-agent-answer-schema-1.0.0.json",
    "schema_ref": "ITER-003-MATURE-SOURCE-AGENT-ANSWER@1.0.0",
    "schema_digest": "sha256:cfe6ea01dedfbbd795676d00a90f7bf74d8227694ccb35a6f9a356a720e8e17d"
  },
  "isolation": {
    "repository_copy": "CONTAINS_ONLY_EXACT_GIT_SOURCE_TARGET",
    "file_access_policy": "OS_OR_CONTAINER_ALLOWLIST_EXACT_BINARY_RUNTIME_AND_ISOLATED_CHECKOUT_ALL_OTHER_OPENS_FAIL",
    "forbidden_mounts": ["product_question_evaluator_oracle", "metamorphic_oracle", "world_model_results", "controlled_direct_results"],
    "forbidden_reads": ["parent_of_isolated_checkout", "original_workspace", "network", "provider_memory"],
    "audit": "SAVE_COMMAND_WITHOUT_SECRETS_EVENT_LOG_STDOUT_STDERR_EXIT_STATUS_AND_FILE_OPERATION_AUDIT"
  },
  "comparison": {
    "cases": "EVERY_PRODUCT_CASE_WITH_DIRECT_PARITY_TRUE_PLUS_RUNTIME_METAMORPHIC_SUPPORTED_CASES",
    "runs_per_case": 5,
    "cold_process_required": true,
    "timing": "COMPLETE_AND_SEAL_AFTER_G0_TOOL_RECHECK_AND_BEFORE_FIRST_G3B_PRODUCT_RUN",
    "quality_rule": "WORLD_MODEL_MAJOR_ERROR_ZERO_AND_COMPLETENESS_NOT_LOWER_THAN_THE_STRONGER_OF_CONTROLLED_DIRECT_AND_MATURE_AGENT_PER_CASE",
    "performance_rule": "NO_CROSS_MODEL_LATENCY_RATIO_MATURE_AGENT_IS_QUALITY_COMPARATOR_ONLY",
    "failure_rule": "KEEP_ALL_FAILURES_DO_NOT_SELECT_SUCCESSES"
  }
}
